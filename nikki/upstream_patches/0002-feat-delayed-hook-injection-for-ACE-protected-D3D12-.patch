+static void PebUnlinkModule(void *base)
+{
+  BYTE *peb = (BYTE *)__readgsqword(0x60);
+  BYTE *ldr = *(BYTE **)(peb + 0x18);
+  BYTE *head = *(BYTE **)(ldr + 0x10);
+  BYTE *cur = head;
+  int count = 0;
+  while(count < 500)
+  {
+    BYTE *next = *(BYTE **)cur;
+    if(next == head) break;
+    void *dllBase = *(void **)(cur + 0x30);
+    if(dllBase == base)
+    {
+      *(BYTE **)(*(BYTE **)(cur + 0x00) + 0x08) = *(BYTE **)(cur + 0x08);
+      *(BYTE **)(*(BYTE **)(cur + 0x08) + 0x00) = *(BYTE **)(cur + 0x00);
+      *(BYTE **)(*(BYTE **)(cur + 0x10) + 0x18) = *(BYTE **)(cur + 0x18);
+      *(BYTE **)(*(BYTE **)(cur + 0x18) + 0x10) = *(BYTE **)(cur + 0x10);
+      *(BYTE **)(*(BYTE **)(cur + 0x20) + 0x28) = *(BYTE **)(cur + 0x28);
+      *(BYTE **)(*(BYTE **)(cur + 0x28) + 0x20) = *(BYTE **)(cur + 0x20);
+      Log("PEB unlinked %p\n", base);
+      return;
+    }
+    cur = next;
+    count++;
+  }
+  Log("PEB unlink: not found\n");
+}
+
+static void LoadRhdoc()
+{
+  if(InterlockedCompareExchange(&g_rhdocLoaded, 0, 0) == 1)
+    return;
+
+  SetEnvironmentVariableA("RENDERDOC_DELAY_HOOKS", "1");
+
+  wchar_t myPath[MAX_PATH];
+  GetModuleFileNameW((HMODULE)&__ImageBase, myPath, MAX_PATH);
+  wchar_t *slash = wcsrchr(myPath, L'\\');
+  if(slash) wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - myPath), L"dxil.dll");
+
+  static bool firstLoad = true;
+  if(firstLoad)
+  {
+    firstLoad = false;
+    Log("Delaying rhdoc load by 90s to avoid ACE detection...\n");
+    Sleep(90000);
+  }
+
+  Log("Loading rhdoc (delayed mode) from %ls\n", myPath);
+  g_hRhdoc = LoadLibraryW(myPath);
+  if(!g_hRhdoc)
+  {
+    Log("rhdoc LOAD FAILED: err=%u\n", GetLastError());
+    return;
+  }
+  Log("rhdoc at %p (hooks delayed)\n", g_hRhdoc);
+
+  //PebUnlinkModule((void *)g_hRhdoc);
+  //Log("PEB unlink SKIPPED\n");
+
+  g_NotifyHookModule = (PFN_NotifyHookModule)g_realGetProcAddress(g_hRhdoc, "RHDOC_NotifyHookModule");
+  g_InstallDelayedHooks = (PFN_InstallDelayedHooks)g_realGetProcAddress(g_hRhdoc, "RHDOC_InstallDelayedHooks");
+  g_WrapD3D12Device = (PFN_WrapD3D12Device)g_realGetProcAddress(g_hRhdoc, "RHDOC_WrapD3D12Device");
+
+  Log("rhdoc exports: NotifyHookModule=%p InstallDelayedHooks=%p WrapD3D12Device=%p\n",
+      g_NotifyHookModule, g_InstallDelayedHooks, g_WrapD3D12Device);
+
+  InterlockedExchange(&g_rhdocLoaded, 1);
+}
