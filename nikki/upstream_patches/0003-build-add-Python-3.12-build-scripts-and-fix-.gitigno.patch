@@ -0,0 +1,100 @@
+@echo off
+setlocal
+
+set MSBUILD=C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe
+set ROOT=D:\git\renderdoc
+set SLN_DIR=%ROOT%\
+set PY_DIR=%ROOT%\py312-build
+set ARGS=/p:Configuration=Release /p:SolutionDir=%SLN_DIR% /p:VSPythonOverridePath="%PY_DIR%" /v:minimal /m
+
+if not exist "%MSBUILD%" (
+    echo MSBuild not found at %MSBUILD%
+    exit /b 1
+)
+
+if not exist "%PY_DIR%\python312.lib" (
+    echo Python 3.12 build dir not found at %PY_DIR%
+    echo Run build_py312.ps1 first to prepare it.
+    exit /b 1
+)
+
+echo Using Python 3.12 from: %PY_DIR%
+
+echo.
+echo ===== x64 renderdoc =====
+"%MSBUILD%" %ROOT%\renderdoc\renderdoc.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== x64 renderdoccmd =====
+"%MSBUILD%" %ROOT%\renderdoccmd\renderdoccmd.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== x64 qrenderdoc =====
+"%MSBUILD%" %ROOT%\qrenderdoc\qrenderdoc_local.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== x64 pyrenderdoc_module =====
+"%MSBUILD%" %ROOT%\qrenderdoc\Code\pyrenderdoc\pyrenderdoc_module.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== x64 qrenderdoc_module =====
+"%MSBUILD%" %ROOT%\qrenderdoc\Code\pyrenderdoc\qrenderdoc_module.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== x64 renderdocshim =====
+"%MSBUILD%" %ROOT%\renderdocshim\renderdocshim.vcxproj /p:Platform=x64 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== Win32 breakpad =====
+"%MSBUILD%" %ROOT%\renderdoc\3rdparty\breakpad\client\windows\common.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+"%MSBUILD%" %ROOT%\renderdoc\3rdparty\breakpad\client\windows\crash_generation\crash_generation_client.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+"%MSBUILD%" %ROOT%\renderdoc\3rdparty\breakpad\client\windows\crash_generation\crash_generation_server.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+"%MSBUILD%" %ROOT%\renderdoc\3rdparty\breakpad\client\windows\handler\exception_handler.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== Win32 renderdoccmd =====
+"%MSBUILD%" %ROOT%\renderdoccmd\renderdoccmd.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== Win32 renderdocshim =====
+"%MSBUILD%" %ROOT%\renderdocshim\renderdocshim.vcxproj /p:Platform=Win32 %ARGS%
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== Compile fast_injector =====
+call :compile_injector
+if errorlevel 1 goto :fail
+
+echo.
+echo ===== Packing =====
+cd /d "%~dp0"
+uv run pack_dist.py
+if errorlevel 1 goto :fail
+
+echo.
+echo Done!
+exit /b 0
+
+:compile_injector
+set "VC=C:\Program Files\Microsoft Visual Studio\18\Community\VC\Tools\MSVC\14.50.35717"
+set "SDK=C:\Program Files (x86)\Windows Kits\10"
+set "OUTDIR=%ROOT%\x64\Release"
+pushd "%OUTDIR%"
+"%VC%\bin\Hostx64\x64\cl.exe" /O2 /MT /EHsc /I"%VC%\include" /I"%SDK%\Include\10.0.26100.0\shared" /I"%SDK%\Include\10.0.26100.0\um" /I"%SDK%\Include\10.0.26100.0\ucrt" /Fe"%OUTDIR%\fast_injector.exe" "%ROOT%\tools\inject\fast_injector.cpp" /link /LIBPATH:"%VC%\lib\x64" /LIBPATH:"%SDK%\Lib\10.0.26100.0\um\x64" /LIBPATH:"%SDK%\Lib\10.0.26100.0\ucrt\x64"
+popd
+exit /b %errorlevel%
+
+:fail
+echo FAILED
+exit /b 1
