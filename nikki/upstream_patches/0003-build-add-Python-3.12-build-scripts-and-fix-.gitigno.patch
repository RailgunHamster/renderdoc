diff --git a/tools/build/build_py312.ps1 b/tools/build/build_py312.ps1
new file mode 100644
index 000000000..1ad24ebef
--- /dev/null
+++ b/tools/build/build_py312.ps1
@@ -0,0 +1,27 @@
+$ErrorActionPreference = "Stop"
+
+$Root = Split-Path -Parent (Split-Path -Parent (Split-Path -Parent $MyInvocation.MyCommand.Path))
+$PyDir = Join-Path $Root "py312-build"
+$Msbuild = "C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Current\Bin\MSBuild.exe"
+
+if (-not (Test-Path $PyDir)) {
+    $pyInstall = uv python find 3.12.13 2>$null
+    if (-not $pyInstall) {
+        Write-Host "Installing Python 3.12.13 via uv..."
+        uv python install 3.12.13
+        $pyInstall = uv python find 3.12.13
+    }
+    $pyRoot = Split-Path -Parent $pyInstall
+    Write-Host "Preparing Python 3.12 build dir: $PyDir"
+    New-Item -ItemType Directory -Path $PyDir -Force | Out-Null
+    Copy-Item -Path "$pyRoot\include" -Destination "$PyDir\include" -Recurse -Force
+    Copy-Item -Path "$pyRoot\libs\python312.lib" -Destination "$PyDir\python312.lib" -Force
+    Copy-Item -Path "$pyRoot\python312.dll" -Destination "$PyDir\python312.dll" -Force
+    if (-not (Test-Path "$PyDir\python312.zip")) {
+        Add-Type -AssemblyName System.IO.Compression.FileSystem
+        [System.IO.Compression.ZipFile]::CreateFromDirectory("$pyRoot\Lib", "$PyDir\python312.zip")
+    }
+}
+
+Write-Host "Python 3.12 build dir: $PyDir"
+& $Msbuild "$Root\renderdoc.sln" /p:Configuration=Release /p:Platform=x64 /p:VSPythonOverridePath="$PyDir" /m /v:minimal
