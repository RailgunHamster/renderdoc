+# /// script
+# requires-python = ">=3.12"
+# ///
+import shutil
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).parent.parent.parent
+DIST_DIR = ROOT / "dist"
+
+X64_FILES = [
+    "renderdoccmd.exe",
+    "rhdoc.dll",
+    "rhdoc.json",
+    "renderdocshim64.dll",
+    "renderdoc_app.h",
+    "rhdocui.exe",
+    "qrhdoc.exe",
+    "d3dcompiler_47.dll",
+    "dbghelp.dll",
+    "symsrv.dll",
+    "symsrv.yes",
+    "python312.dll",
+    "python312.zip",
+    "_ctypes.pyd",
+    "Qt5Core.dll",
+    "Qt5Gui.dll",
+    "Qt5Network.dll",
+    "Qt5Svg.dll",
+    "Qt5Widgets.dll",
+    "fast_injector.exe",
+]
+
+X64_EXTRA = {
+    str(ROOT / "tools" / "inject" / "hook_infinity.bat"): "hook_infinity.bat",
+}
+
+X64_PYMODULES = {
+    "pymodules/renderdoc.pyd": "pymodules/renderdoc.pyd",
+    "pymodules/qrenderdoc.pyd": "pymodules/qrenderdoc.pyd",
+}
+
+X64_QT_PLUGINS = {
+    "qtplugins/imageformats/qsvg.dll": "qtplugins/imageformats/qsvg.dll",
+    "qtplugins/platforms/qwindows.dll": "qtplugins/platforms/qwindows.dll",
+}
+
+WIN32_FILES = [
+    "renderdoccmd.exe",
+    "rhdoc.dll",
+    "rhdoc.json",
+    "renderdoc_app.h",
+    "d3dcompiler_47.dll",
+    "dbghelp.dll",
+    "symsrv.dll",
+    "symsrv.yes",
+]
+
+ARCHIVE_NAME = "renderdoc.7z"
+
+
+def find_7z():
+    for name in ("7z", "7z.exe"):
+        p = shutil.which(name)
+        if p:
+            return p
+    for c in [
+        Path(r"C:\Program Files\7-Zip\7z.exe"),
+        Path(r"C:\Program Files (x86)\7-Zip\7z.exe"),
+    ]:
+        if c.exists():
+            return str(c)
+    return None
+
+
+def copy_files(build_dir, dist_dir, files, sub_files=None, qt_plugins=None):
+    copied = 0
+    missing = 0
+    for name in files:
+        src = build_dir / name
+        dst = dist_dir / name
+        if src.exists():
+            shutil.copy2(src, dst)
+            copied += 1
+        else:
+            print(f"    MISSING: {name}")
+            missing += 1
+    if sub_files:
+        for rel_src, rel_dst in sub_files.items():
+            src = build_dir / rel_src
+            dst = dist_dir / rel_dst
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            if src.exists():
+                shutil.copy2(src, dst)
+                copied += 1
+            else:
+                print(f"    MISSING: {rel_src}")
+                missing += 1
+    if qt_plugins:
+        for rel_src, rel_dst in qt_plugins.items():
+            src = build_dir / rel_src
+            dst = dist_dir / rel_dst
+            dst.parent.mkdir(parents=True, exist_ok=True)
+            if src.exists():
+                shutil.copy2(src, dst)
+                copied += 1
+            else:
+                print(f"    MISSING: {rel_src}")
+                missing += 1
+    return copied, missing
+
+
+def make_archive(sevenz, dist_dir, archive_path):
+    if archive_path.exists():
+        archive_path.unlink()
+    all_files = [
+        f.relative_to(dist_dir)
+        for f in dist_dir.rglob("*")
+        if f.is_file() and f.name != archive_path.name
+    ]
+    if not all_files:
+        print("  No files to archive!")
+        return
+    cmd = [sevenz, "a", str(archive_path), "-mx=5"] + [str(p) for p in all_files]
+    result = subprocess.run(cmd, cwd=dist_dir, capture_output=True, text=True)
+    if result.returncode == 0:
+        size_mb = archive_path.stat().st_size / (1024 * 1024)
+        print(f"  {archive_path.name} ({size_mb:.1f} MB)")
+    else:
+        print(f"  7z failed: {result.stderr}")
+
+
+def main():
+    DIST_DIR.mkdir(parents=True, exist_ok=True)
+    total_copied = 0
+    total_missing = 0
+
+    x64_build = ROOT / "x64" / "Release"
+    if x64_build.exists():
+        print("x64 -> dist/")
+        c, m = copy_files(x64_build, DIST_DIR, X64_FILES, X64_PYMODULES, X64_QT_PLUGINS)
+        total_copied += c
+        total_missing += m
+        for src, dst_name in X64_EXTRA.items():
+            src = Path(src)
+            dst = DIST_DIR / dst_name
+            if src.exists():
+                shutil.copy2(src, dst)
+                total_copied += 1
+            else:
+                print(f"    MISSING: {src}")
+                total_missing += 1
+        print(f"  {total_copied} files copied")
+    else:
+        print("x64: build not found, skipping")
+
+    win32_build = ROOT / "Win32" / "Release"
+    if win32_build.exists():
+        print("Win32 -> dist/x86/")
+        win32_dist = DIST_DIR / "x86"
+        win32_dist.mkdir(parents=True, exist_ok=True)
+        c, m = copy_files(win32_build, win32_dist, WIN32_FILES)
+        total_copied += c
+        total_missing += m
+        print(f"  {c} files copied")
+    else:
+        print("Win32: build not found, skipping")
+
+    print(f"\nTotal: {total_copied} files copied")
+    if total_missing:
+        print(f"  {total_missing} missing")
+
+    sevenz = find_7z()
+    if sevenz:
+        print("\nCompressing...")
+        make_archive(sevenz, DIST_DIR, DIST_DIR / ARCHIVE_NAME)
+    else:
+        print("\n7z not found, skipping archive")
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
