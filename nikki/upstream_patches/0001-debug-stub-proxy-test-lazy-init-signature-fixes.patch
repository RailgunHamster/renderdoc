@@ -0,0 +1,84 @@
+#include <windows.h>
+#include <stdio.h>
+
+static void Log(const char *msg) {
+  HANDLE f = CreateFileA("C:\\Users\\Administrator\\gp_trace.log", FILE_APPEND_DATA,
+                          FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, 0, NULL);
+  if(f != INVALID_HANDLE_VALUE) {
+    DWORD written; WriteFile(f, msg, (DWORD)strlen(msg), &written, NULL);
+    WriteFile(f, "\r\n", 2, &written, NULL); CloseHandle(f);
+  }
+}
+
+static void LogBytes(const char *prefix, void *addr, int count) {
+  char buf[256]; int pos = 0;
+  while(*prefix && pos < 200) buf[pos++] = *prefix++;
+  buf[pos++] = ':'; buf[pos++] = ' ';
+  BYTE *p = (BYTE *)addr;
+  for(int i = 0; i < count && pos < 230; i++) {
+    buf[pos++] = "0123456789ABCDEF"[p[i] >> 4];
+    buf[pos++] = "0123456789ABCDEF"[p[i] & 0xF];
+    buf[pos++] = ' ';
+  }
+  buf[pos] = 0; Log(buf);
+}
+
+static void *FollowJmpChain(void *addr) {
+  BYTE *p = (BYTE *)addr;
+  for(int i = 0; i < 32; i++) {
+    // Skip mov r8, [rsp] (4C 8B 04 24) - x64 GP prologue
+    if(p[0] == 0x4C && p[1] == 0x8B && p[2] == 0x04 && p[3] == 0x24) {
+      p += 4;
+      continue;
+    }
+    // jmp [rip+disp32] (FF 25 xx xx xx xx) with optional REX.W (48)
+    int off = 0;
+    if(p[0] == 0x48) off = 1;  // REX.W prefix
+    if(p[off] == 0xFF && p[off+1] == 0x25) {
+      INT32 disp = *(INT32 *)&p[off+2];
+      p = *(BYTE **)((UINT64)(p + off + 6) + disp);
+      continue;
+    }
+    // jmp rel32 (E9 xx xx xx xx)
+    if(p[0] == 0xE9) {
+      INT32 disp = *(INT32 *)&p[1];
+      p = p + 5 + disp;
+      continue;
+    }
+    break;
+  }
+  return p;
+}
+
+int main() {
+  DeleteFileA("C:\\Users\\Administrator\\gp_trace.log");
+
+  void *gpAddr = (void *)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetProcAddress");
+  LogBytes("kernel32!GP", gpAddr, 16);
+
+  void *chain = FollowJmpChain(gpAddr);
+  LogBytes("real GP (followed)", chain, 16);
+
+  // Also check kernelbase
+  HMODULE kb = LoadLibraryA("kernelbase.dll");
+  if(kb) {
+    void *kb_gp = (void *)GetProcAddress(kb, "GetProcAddress");
+    LogBytes("kernelbase!GP", kb_gp, 16);
+    void *kb_chain = FollowJmpChain(kb_gp);
+    LogBytes("kernelbase GP (followed)", kb_chain, 16);
+  }
+
+  // Check ntdll
+  HMODULE nt = GetModuleHandleA("ntdll.dll");
+  if(nt) {
+    void *nt_gp = (void *)GetProcAddress(nt, "LdrGetProcedureAddress");
+    LogBytes("ntdll!LdrGetProcAddr", nt_gp, 16);
+  }
+
+  // Also check if there's a known export we can verify
+  void *realGP = FollowJmpChain(gpAddr);
+  LogBytes("real GP bytes", realGP, 32);
+
+  printf("Done. Check C:\\Users\\Administrator\\gp_trace.log\n");
+  return 0;
+}
