+++ b/tools/inject/proxy_d3d12/d3d12_stub.cpp
@@ -0,0 +1,38 @@
+#include <windows.h>
+#define LOG_FILE L"C:\\Users\\Administrator\\d3d12_proxy.log"
+static void Log(const char *fmt) {
+  HANDLE f = CreateFileW(LOG_FILE, FILE_APPEND_DATA, FILE_SHARE_READ|FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, 0, NULL);
+  if(f != INVALID_HANDLE_VALUE) { DWORD w; WriteFile(f, fmt, (DWORD)strlen(fmt), &w, NULL); CloseHandle(f); }
+}
+static const char *g_lastFwd = "none";
+#define STUB(name, ret, ...) \
+  extern "C" __declspec(dllexport) ret WINAPI _exp_##name(__VA_ARGS__) { g_lastFwd = #name; Log("STUB: " #name "\n"); return (ret)0; }
+
+STUB(D3D12GetDebugInterface, HRESULT, REFIID riid, void **ppvDebug)
+STUB(D3D12GetInterface, HRESULT, REFIID riid, void **ppv)
+STUB(D3D12EnableExperimentalFeatures, HRESULT, UINT a, const IID *b, void *c, UINT *d)
+STUB(D3D12SerializeRootSignature, HRESULT, void *a, int b, void **c, void **d)
+STUB(D3D12SerializeVersionedRootSignature, HRESULT, void *a, void **b, void **c)
+STUB(D3D12CreateRootSignatureDeserializer, HRESULT, void *a, SIZE_T b, REFIID c, void **d)
+STUB(D3D12CreateVersionedRootSignatureDeserializer, HRESULT, void *a, SIZE_T b, REFIID c, void **d)
+STUB(D3D12CoreCreateLayeredDevice, HRESULT, void *a, REFIID b, void **c)
+STUB(D3D12CoreGetLayeredDeviceSize, SIZE_T, const void *a, UINT b)
+STUB(D3D12CoreRegisterLayers, UINT, void *a, UINT b)
+STUB(D3D12DeviceRemovedExtendedData, HRESULT, void *a, int b, void *c)
+STUB(SetAppCompatStringPointer, HRESULT, const char *a, const char *b)
+STUB(GetBehaviorValue, HRESULT, void *a, void *b)
+STUB(D3D12PIXEventsReplaceBlock, HRESULT, void *a, void *b, void *c, void *d)
+STUB(D3D12PIXGetThreadInfo, void, void *a)
+STUB(D3D12PIXNotifyWakeFromFenceSignal, HRESULT, void *a, int b)
+STUB(D3D12PIXReportCounter, HRESULT, void *a, void *b)
+STUB(Ordinal99, HRESULT)
+
+extern "C" __declspec(dllexport) HRESULT WINAPI D3D12CreateDevice(void *a, int b, REFIID c, void **d) {
+  g_lastFwd = "D3D12CreateDevice"; Log("STUB: D3D12CreateDevice\n"); return 0x887E0003;
+}
+
+BOOL APIENTRY DllMain(HMODULE h, DWORD r, LPVOID l) {
+  if(r == DLL_PROCESS_ATTACH) { DeleteFileW(LOG_FILE); Log("=== STUB proxy ===\n"); }
+  else if(r == DLL_PROCESS_DETACH) { Log("=== STUB DETACH: last="); Log(g_lastFwd); Log(" ===\n"); }
+  return TRUE;
+}
diff --git a/tools/inject/proxy_xinput/xinput_proxy_v12.cpp b/tools/inject/proxy_xinput/xinput_proxy_v12.cpp
new file mode 100644
index 000000000..f4c66abc2
--- /dev/null
+++ b/tools/inject/proxy_xinput/xinput_proxy_v12.cpp
@@ -0,0 +1,229 @@
+#include <windows.h>
+#include <stdio.h>
+
+#pragma comment(lib, "kernel32.lib")
+
+#define LOG_FILE L"C:\\Users\\Administrator\\xinput_proxy.log"
+
+static void Log(const char *msg)
+{
+  HANDLE f = CreateFileA("C:\\Users\\Administrator\\xinput_proxy.log", FILE_APPEND_DATA,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, 0, NULL);
+  if(f != INVALID_HANDLE_VALUE)
+  {
+    DWORD written;
+    WriteFile(f, msg, (DWORD)strlen(msg), &written, NULL);
+    WriteFile(f, "\r\n", 2, &written, NULL);
+    CloseHandle(f);
+  }
+}
+
+static void LogBytes(const char *prefix, void *addr, int count)
+{
+  char buf[256]; int pos = 0;
+  while(*prefix && pos < 200) buf[pos++] = *prefix++;
+  buf[pos++] = ':'; buf[pos++] = ' ';
+  BYTE *p = (BYTE *)addr;
+  for(int i = 0; i < count && pos < 230; i++)
+  {
+    buf[pos++] = "0123456789ABCDEF"[p[i] >> 4];
+    buf[pos++] = "0123456789ABCDEF"[p[i] & 0xF];
+    buf[pos++] = ' ';
+  }
+  buf[pos] = 0; Log(buf);
+}
+
+static void PebUnlinkModule(void *base)
+{
+  BYTE *peb = (BYTE *)__readgsqword(0x60);
+  BYTE *ldr = *(BYTE **)(peb + 0x18);
+  BYTE *head = *(BYTE **)(ldr + 0x10);
+  BYTE *cur = head;
+  int count = 0;
+  while(count < 500)
+  {
+    BYTE *next = *(BYTE **)cur;
+    if(next == head) break;
+    void *dllBase = *(void **)(cur + 0x30);
+    if(dllBase == base)
+    {
+      *(BYTE **)(*(BYTE **)(cur + 0x00) + 0x08) = *(BYTE **)(cur + 0x08);
+      *(BYTE **)(*(BYTE **)(cur + 0x08) + 0x00) = *(BYTE **)(cur + 0x00);
+      *(BYTE **)(*(BYTE **)(cur + 0x10) + 0x18) = *(BYTE **)(cur + 0x18);
+      *(BYTE **)(*(BYTE **)(cur + 0x18) + 0x10) = *(BYTE **)(cur + 0x10);
+      *(BYTE **)(*(BYTE **)(cur + 0x20) + 0x28) = *(BYTE **)(cur + 0x28);
+      *(BYTE **)(*(BYTE **)(cur + 0x28) + 0x20) = *(BYTE **)(cur + 0x20);
+      Log("PEB unlinked");
+      return;
+    }
+    cur = next; count++;
+  }
+  Log("PEB unlink: not found");
+}
+
+static void *FollowJmpChain(void *addr)
+{
+  BYTE *p = (BYTE *)addr;
+  for(int i = 0; i < 32; i++)
+  {
+    // Skip mov r8, [rsp] (x64 GP prologue)
+    if(p[0] == 0x4C && p[1] == 0x8B && p[2] == 0x04 && p[3] == 0x24)
+    { p += 4; continue; }
+    // REX.W + jmp [rip+disp32]
+    int off = 0;
+    if(p[0] == 0x48) off = 1;
+    if(p[off] == 0xFF && p[off+1] == 0x25)
+    {
+      INT32 disp = *(INT32 *)&p[off+2];
+      p = *(BYTE **)((UINT64)(p + off + 6) + disp);
+      continue;
+    }
+    // jmp rel32
+    if(p[0] == 0xE9)
+    {
+      INT32 disp = *(INT32 *)&p[1];
+      p = p + 5 + disp;
+      continue;
+    }
+    break;
+  }
+  return p;
+}
+
+typedef FARPROC(WINAPI *PFN_GetProcAddress)(HMODULE, LPCSTR);
+typedef HRESULT(WINAPI *PFN_D3D12CreateDevice)(void *, int, REFIID, void **);
+
+static void *g_realGP = NULL;
+static BYTE g_savedGP[16] = {};
+static int g_savedSize = 0;
+static volatile LONG g_intercepted = 0;
+static CRITICAL_SECTION g_cs;
+
+static void LoadRhdoc()
+{
+  wchar_t path[MAX_PATH];
+  GetModuleFileNameW(NULL, path, MAX_PATH);
+  wchar_t *slash = wcsrchr(path, L'\\');
+  if(slash)
+    wcscpy_s(slash + 1, MAX_PATH - (slash + 1 - path), L"rhdoc.dll");
+
+  HMODULE h = LoadLibraryW(path);
+  if(h)
+  {
+    Log("rhdoc loaded OK");
+    PebUnlinkModule((void *)h);
+  }
+  else
+    Log("rhdoc LOAD FAILED");
+}
+
+static FARPROC WINAPI HookedGP(HMODULE hModule, LPCSTR lpProcName)
+{
+  if(g_intercepted)
+    return ((PFN_GetProcAddress)g_realGP)(hModule, lpProcName);
+
+  EnterCriticalSection(&g_cs);
+
+  // Restore original bytes to call the real GP
+  DWORD old;
+  VirtualProtect(g_realGP, g_savedSize, PAGE_EXECUTE_READWRITE, &old);
+  memcpy(g_realGP, g_savedGP, g_savedSize);
+  VirtualProtect(g_realGP, g_savedSize, old, &old);
+  FlushInstructionCache(GetCurrentProcess(), g_realGP, g_savedSize);
+
+  FARPROC result = ((PFN_GetProcAddress)g_realGP)(hModule, lpProcName);
+
+  // Check if this is D3D12CreateDevice resolution
+  if(!g_intercepted && lpProcName && HIWORD(lpProcName) != 0 &&
+     strcmp(lpProcName, "D3D12CreateDevice") == 0)
+  {
+    InterlockedExchange(&g_intercepted, 1);
+    Log("D3D12CreateDevice intercepted via GP!");
+    LoadRhdoc();
+    LeaveCriticalSection(&g_cs);
+    return result;  // Return real system d3d12 function pointer
+  }
+
+  // Re-install hook if not yet intercepted
+  if(!g_intercepted)
+  {
+    BYTE patch[16];
+    memset(patch, 0x90, sizeof(patch));
+    patch[0] = 0xFF; patch[1] = 0x25; *(DWORD *)&patch[2] = 0;
+    *(UINT64 *)&patch[6] = (UINT64)&HookedGP;
+    VirtualProtect(g_realGP, g_savedSize, PAGE_EXECUTE_READWRITE, &old);
+    memcpy(g_realGP, patch, g_savedSize);
+    VirtualProtect(g_realGP, g_savedSize, old, &old);
+    FlushInstructionCache(GetCurrentProcess(), g_realGP, g_savedSize);
+  }
+
+  LeaveCriticalSection(&g_cs);
+  return result;
+}
+
+// Forward XInput functions
+static HMODULE g_hRealXInput = NULL;
+
+#define XINPUT_FWD(name, ret, params, args, errret) \
+  extern "C" ret WINAPI name params \
+  { \
+    static ret(WINAPI *p) params = NULL; \
+    if(!p && g_hRealXInput) p = (decltype(p))GetProcAddress(g_hRealXInput, #name); \
+    return p ? p args : errret; \
+  }
+
+XINPUT_FWD(XInputGetState, DWORD, (DWORD a, void *b), (a, b), 1167)
+XINPUT_FWD(XInputSetState, DWORD, (DWORD a, void *b), (a, b), 1167)
+XINPUT_FWD(XInputGetCapabilities, DWORD, (DWORD a, DWORD b, void *c), (a, b, c), 1167)
+XINPUT_FWD(XInputGetKeystroke, DWORD, (DWORD a, DWORD b, void *c), (a, b, c), 1167)
+XINPUT_FWD(XInputGetBatteryInformation, DWORD, (DWORD a, BYTE b, void *c), (a, b, c), 1167)
+XINPUT_FWD(XInputGetAudioDeviceIds, DWORD, (DWORD a, void *b, void *c, void *d, void *e), (a, b, c, d, e), 1167)
+XINPUT_FWD(XInputEnable, void, (BOOL a), (a), (void)0)
+
+extern "C" void WINAPI PIXGetThreadInfo(void *) {}
+extern "C" void WINAPI PIXEventsReplaceBlock(void *) {}
+
+BOOL APIENTRY DllMain(HMODULE hModule, DWORD reason, LPVOID reserved)
+{
+  (void)hModule; (void)reserved;
+
+  if(reason == DLL_PROCESS_ATTACH)
+  {
+    InitializeCriticalSection(&g_cs);
+    DeleteFileW(LOG_FILE);
+    Log("=== XINPUT proxy v12 (fixed GP chain) ===");
+
+    // Load real XInput
+    wchar_t xinputPath[MAX_PATH];
+    GetSystemDirectoryW(xinputPath, MAX_PATH);
+    wcscat(xinputPath, L"\\XINPUT1_4.dll");
+    g_hRealXInput = LoadLibraryW(xinputPath);
+    Log(g_hRealXInput ? "real XINPUT loaded" : "XINPUT FAILED");
+
+    // Find and hook real GetProcAddress
+    void *gpAddr = (void *)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetProcAddress");
+    LogBytes("kernel32 GP", gpAddr, 8);
+
+    void *realGP = FollowJmpChain(gpAddr);
+    LogBytes("real GP", realGP, 16);
+
+    g_realGP = realGP;
+    g_savedSize = 16;
+    memcpy(g_savedGP, realGP, 16);
+
+    BYTE patch[16];
+    memset(patch, 0x90, sizeof(patch));
+    patch[0] = 0xFF; patch[1] = 0x25; *(DWORD *)&patch[2] = 0;
+    *(UINT64 *)&patch[6] = (UINT64)&HookedGP;
+
+    DWORD old;
+    VirtualProtect(realGP, 16, PAGE_EXECUTE_READWRITE, &old);
+    memcpy(realGP, patch, 16);
+    VirtualProtect(realGP, 16, old, &old);
+    FlushInstructionCache(GetCurrentProcess(), realGP, 16);
+    Log("inline GP hook installed");
+
+    Log("=== DllMain done ===");
+  }
+  return TRUE;
+}
